\name{kdrcc-package}
\alias{kdrcc-package}
\alias{kdrcc-package-overview}
\docType{package}
\title{Kernel-Based Doubly Robust Case-Crossover Regression}
\description{KDR-CC estimates nonlinear multiexposure relative effects in individually matched case-crossover data. It combines independent Gaussian-kernel learning, matched-set auxiliary cross-fitting and regularized moment estimation.}
\details{
Start with \code{\link{kdrcc}}, \code{\link{kdrcc_control}} and \code{\link{kdrcc_nuisance}}.
Use \code{\link{kdrcc_split}} for independent samples and \code{\link{kdrcc_tune}} for grouped configuration selection.
Effect summaries include \code{\link{kdrcc_joint}}, \code{\link{kdrcc_single}} and \code{\link{kdrcc_contrast}}.
Participation, interaction and contribution summaries are provided by \code{\link{kdrcc_variables}}, \code{\link{kdrcc_interaction}} and \code{\link{kdrcc_contribution}}.
The installed documentation directory contains the user guide and statistical specification.
}
\author{Peizheng Li \email{pzli25@m.fudan.edu.cn}}
